{
  "expo": {
    "name": "SOGN SAFE",
    "slug": "sogn-safe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/sogn-safe-icon/png-fullbleed/SOGN-SAFE-App-Icon-FullBleed-1024.png",
    "scheme": "sognsafe",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "no.hvl.sognsafe",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "SOGN SAFE uses your location to calculate distance to the nearest safe shelter and to guide your evacuation path during active incidents.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/sogn-safe-icon/png-symbol-square/Symbol-Only-Square-Metallic-1024.png",
        "backgroundColor": "#0B1013",
        "monochromeImage": "./assets/sogn-safe-icon/png-symbol-square-mono/Symbol-Only-Square-Mono-White-1024.png"
      },
      "package": "no.hvl.sognsafe",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/sogn-safe-icon/png/SOGN-SAFE-App-Icon-128.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/sogn-safe-icon/png-symbol-square/Symbol-Only-Square-Metallic-1024.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#0B1013"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SOGN SAFE uses your location to show the nearest verified safe zone and guide your evacuation."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/sogn-safe-icon/png-symbol-square-mono/Symbol-Only-Square-Mono-White-1024.png",
          "color": "#D93829"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3061df7f-5c9b-409c-b4cb-99ff05132785"
      }
    },
    "owner": "uset182"
  }
}
